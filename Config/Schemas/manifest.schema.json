{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://physicstest.local/schemas/manifest.schema.json",
  "title": "PhysicsTest bench run manifest (physicstest.run/2)",
  "description": "manifest.json of one PhysicsTestBench run (docs/ResultsSchema.md, 02_Architecture 12.3, 03_WorkPlan M7). Every run that initialised its backend writes one, refused runs included: a run refused by the engine-option preflight has no scene (scene.built false), so its scene-derived fields are null; every other run satisfies the stricter rules in allOf. Groups may gain fields (additional properties are allowed); the fields listed as required are what M8 analysis and the M7 criteria rely on. M10 fields (comparability_key, conformance_stamp, clock.tsc_hz, threads.census_*, threads.foreign_cycles_fraction, summary.cpu_eff) are null in M7-M9 manifests and filled from M10 on (the M10 bench writes null only where the run stopped before them: no scene, no loop). M8: status usage_error (exit 2) is a run refused after its scene was built because a test-only injection could not take effect (-InjectPreflightFault=g9:<key> on a key G9 does not compare). A headline-valid run (timing_valid_for_headline true) must be internally consistent: status ok, exit code 0, no reasons, Bench mode, no instrumentation tier, no per-frame recorder, no test injection, no allocation inside the timed buckets and an uncontaminated host; an invalid run names at least one reason.",
  "type": "object",
  "required": [
    "schema",
    "status",
    "exit_code",
    "timing_valid_for_headline",
    "timing_invalid_reasons",
    "unofficial",
    "timing_label",
    "comparability_key",
    "conformance_stamp",
    "run_id",
    "session",
    "utc",
    "command_line",
    "harness",
    "build",
    "backend",
    "profile",
    "effective",
    "missing_effective_keys",
    "scene",
    "run",
    "threads",
    "platform",
    "clock",
    "order",
    "phases_ns",
    "memory",
    "alloc",
    "summary",
    "determinism",
    "gates",
    "outputs",
    "wall_time_s"
  ],
  "properties": {
    "schema": {
      "const": "physicstest.run/2"
    },
    "status": {
      "enum": [
        "ok",
        "preflight_failed",
        "engine_error",
        "capacity_exceeded",
        "contaminated_host",
        "usage_error"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4,
        5
      ]
    },
    "timing_valid_for_headline": {
      "type": "boolean"
    },
    "timing_invalid_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unofficial": {
      "description": "M10: false only for a headline-valid run with a valid conformance stamp under a High performance / Ultimate power plan (M7-M9: always true)",
      "type": "boolean"
    },
    "unofficial_reasons": {
      "description": "M10: why the timing is not reportable (empty when unofficial is false)",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing_label": {
      "type": "string",
      "minLength": 1
    },
    "comparability_key": {
      "description": "M10 (02 13): SHA-256 of the canonical comparability fields (FRunManifest::ComputeComparabilityKey, Tools/ptbench/analysis/comparability.py); null without a scene",
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "conformance_stamp": {
      "description": "M10 (02 12.2 step 7, 12.4): the stamp the bench found for its own key (never a refusal: the runner refuses); null in M7-M9 manifests",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "key_sha256",
            "found",
            "valid",
            "reason",
            "path",
            "stamp_dir",
            "key"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "found": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "session": {
      "type": "string"
    },
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "command_line": {
      "type": "string"
    },
    "preflight_error": {
      "type": "string"
    },
    "harness": {
      "type": "object",
      "required": [
        "git_sha",
        "dirty",
        "git_sha_source",
        "exe",
        "exe_sha256",
        "preset"
      ],
      "properties": {
        "git_sha": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        },
        "git_sha_source": {
          "enum": [
            "build",
            "cmake_configure"
          ]
        },
        "exe": {
          "type": "string"
        },
        "exe_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "preset": {
          "type": "string"
        },
        "do_check": {
          "type": "boolean"
        },
        "sdks": {
          "type": "array",
          "items": {
            "enum": [
              "Jolt",
              "Bullet",
              "PhysX",
              "Chaos"
            ]
          },
          "uniqueItems": true,
          "description": "M10 fix round 1: the SDK backends compiled into this exe (PT_WITH_<SDK>): one SDK = a single-SDK exe, the binary composition control (02 14.3; Tools/ptbench perf.py decides by this, not by the preset name). Absent before M10 fix round 1"
        }
      }
    },
    "build": {
      "type": "object",
      "required": [
        "flag_profile",
        "configuration",
        "msvc",
        "cmake",
        "crt",
        "lto",
        "flags_json_sha256",
        "flags_json_violations"
      ],
      "properties": {
        "flag_profile": {
          "enum": [
            "Shipped",
            "MatchedAVX2"
          ]
        },
        "configuration": {
          "enum": [
            "Debug",
            "Release"
          ]
        },
        "crt": {
          "enum": [
            "MD",
            "MDd",
            "MT",
            "MTd"
          ]
        },
        "lto": {
          "type": "boolean"
        },
        "flags_json_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "flags_json_tu_count": {
          "type": "integer",
          "minimum": 0
        },
        "flags_json_violations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "backend": {
      "type": "object",
      "required": [
        "name",
        "variant",
        "label",
        "sdk_version",
        "sdk_sha",
        "abi_version",
        "capabilities",
        "module_flags",
        "module_sha256",
        "fidelity_notes",
        "tu_self_report"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "abi_version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+$"
        },
        "module_abi_version": {
          "description": "M9 fix round 2: the module's own PtBackendApi.AbiVersion (major.minor); abi_version is the host header's. Absent in older manifests",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "module_provisional_revision": {
          "description": "M9 fix round 2: PtBackendInfo.ProvisionalRevision as the module reported it (3 = abi-v1.1). Absent in older manifests",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "module_flags": {
          "type": "integer",
          "minimum": 0
        },
        "module_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "fidelity_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "physics",
        "mass_rule",
        "physics_sha256",
        "variant_sha256",
        "resolved"
      ],
      "properties": {
        "physics": {
          "type": "string",
          "minLength": 1
        },
        "mass_rule": {
          "type": "string"
        },
        "physics_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "variant_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "const": ""
            }
          ]
        },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "value",
              "origin"
            ]
          }
        }
      }
    },
    "effective": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effective"
      }
    },
    "effective_module": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effective"
      }
    },
    "missing_effective_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bodies_sampled": {
      "type": "array"
    },
    "scene": {
      "type": "object",
      "required": [
        "name",
        "version",
        "kind",
        "params",
        "seed",
        "scene_sha256",
        "built",
        "desc_sha256",
        "desc_sha256_scope",
        "options_sha256",
        "num_bodies",
        "windows"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][0-9A-Za-z]*\\.[A-Za-z0-9]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "Gate",
            "Overhead",
            "Behavior",
            "Perf",
            "Extended"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "seed": {
          "type": "integer"
        },
        "scene_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "desc_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "options_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "num_bodies": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "first",
              "last"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "first": {
                "type": "integer",
                "minimum": 0
              },
              "last": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "built": {
          "type": "boolean",
          "description": "false: the engine-option preflight refused the variant before the scene was built"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "mode",
        "instrumentation",
        "instrument_flags",
        "frames",
        "frames_run",
        "dt_s",
        "dt_engine_s",
        "tick_mode",
        "clamp_rule",
        "frame_driver",
        "sync_policy",
        "hash_every",
        "states_every",
        "counters_every",
        "capture_every",
        "pre_roll_s",
        "async_interpolated",
        "test_injections"
      ],
      "properties": {
        "mode": {
          "enum": [
            "Bench",
            "Behavior",
            "Viz"
          ]
        },
        "instrumentation": {
          "type": "array",
          "items": {
            "enum": [
              "counters",
              "phases",
              "alloc",
              "contacts",
              "native_debug_draw"
            ]
          },
          "uniqueItems": true
        },
        "instrument_flags": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        },
        "frames": {
          "type": "integer",
          "minimum": 1
        },
        "frames_run": {
          "type": "integer",
          "minimum": 0
        },
        "dt_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dt_engine_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tick_mode": {
          "enum": [
            "FixedStep",
            "Sync",
            "Substepping",
            "AsyncFixed"
          ]
        },
        "frame_driver": {
          "enum": [
            "Harness",
            "Native",
            null
          ]
        },
        "sync_policy": {
          "enum": [
            "push_per_step+pull_active_only_per_frame",
            "push_per_frame+pull_active_only_per_frame",
            null
          ]
        },
        "hash_every": {
          "type": "integer",
          "minimum": 0
        },
        "states_every": {
          "type": "integer",
          "minimum": 0
        },
        "counters_every": {
          "type": "integer",
          "minimum": 0
        },
        "capture_every": {
          "type": "integer",
          "minimum": 0
        },
        "pre_roll_s": {
          "type": "number",
          "minimum": 0
        },
        "async_interpolated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "test_injections": {
          "type": "object"
        }
      }
    },
    "threads": {
      "type": "object",
      "required": [
        "T",
        "affinity_mask",
        "affinity_applied",
        "logical_cpus",
        "series",
        "cores",
        "engine_native",
        "engine_thread_settings",
        "scaling_note",
        "census_init",
        "census_window",
        "foreign_cycles_fraction"
      ],
      "properties": {
        "T": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "affinity_mask": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "affinity_applied": {
          "type": "boolean"
        },
        "logical_cpus": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "minItems": 1
        },
        "engine_native": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "workers",
                "native",
                "source"
              ],
              "properties": {
                "workers": {
                  "type": [
                    "integer",
                    "number",
                    "null"
                  ]
                },
                "native": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "engine_thread_settings": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "scaling_note": {
          "type": "string",
          "minLength": 1
        },
        "census_init": {
          "description": "M10 (02 12.2 step 5): census #1 after InitGamePhys - every thread of the process with its name and cycles",
          "type": [
            "object",
            "null"
          ]
        },
        "census_window": {
          "description": "M10 (02 12.2 step 11): the census window around the loop - own / main / foreign cycles, cpu_eff, cpu_eff_raw, per thread",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "valid",
                "T",
                "wall_s",
                "own_cycles",
                "main_cycles",
                "foreign_cycles",
                "cpu_eff",
                "cpu_eff_raw",
                "foreign_cycles_fraction",
                "per_thread"
              ],
              "properties": {
                "own_s": {
                  "type": "number",
                  "minimum": 0,
                  "description": "M10 fix round 1: own cycles at the window's TSC rate - G10b's minimum window (50 ms of own CPU time)"
                },
                "other_on_mask_fraction": {
                  "type": "number",
                  "minimum": 0,
                  "description": "M10 fix round 1: other processes / interrupts on the mask's CPUs / (wall x T) - G10b's contended rule (> 5 %)"
                },
                "g10b_skip": {
                  "enum": [
                    "",
                    "multi_thread",
                    "no_census",
                    "short_window",
                    "contended"
                  ],
                  "description": "M10 fix round 1: why the run's G10b is Skip ('' = a verdict). A T = 1 run with no_census or contended has no single-thread proof and is not headline-valid; short_window rests on the stamp's G10b run"
                }
              }
            }
          ]
        },
        "foreign_cycles_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "series": {
          "enum": [
            "p_cores_one_lp",
            "p_cores_smt",
            "with_e_cores"
          ],
          "description": "02 9.6: one logical CPU per P-core (the default T series), an SMT pair in the mask (HT series), an E-core in the mask"
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "platform": {
      "type": "object",
      "required": [
        "cpu",
        "logical_processors",
        "p_cores",
        "os_build",
        "priority_class",
        "priority_set",
        "throttling",
        "timer_resolution",
        "power_scheme",
        "power_scheme_guid",
        "power_scheme_high_performance",
        "qpc_hz",
        "cpu_mhz",
        "system_busy_other_pct",
        "host_load"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "logical_processors": {
          "type": "integer",
          "minimum": 1
        },
        "p_cores": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "os_build": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "priority_class": {
          "type": "string"
        },
        "priority_set": {
          "type": "boolean"
        },
        "throttling": {
          "type": "object",
          "required": [
            "opt_out_applied"
          ],
          "properties": {
            "opt_out_applied": {
              "type": "boolean"
            }
          }
        },
        "timer_resolution": {
          "type": "object",
          "required": [
            "requested_ms",
            "applied",
            "after"
          ]
        },
        "power_scheme": {
          "type": "string",
          "minLength": 1
        },
        "power_scheme_guid": {
          "type": "string",
          "pattern": "^\\{[0-9A-Fa-f-]{36}\\}$"
        },
        "power_scheme_high_performance": {
          "type": "boolean"
        },
        "qpc_hz": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_mhz": {
          "type": "array"
        },
        "system_busy_other_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "host_load": {
          "type": "object",
          "required": [
            "valid",
            "core_mask",
            "cores",
            "core_busy_other_pct",
            "mask_busy_other_pct",
            "smt_sibling_busy_pct",
            "system_busy_other_pct",
            "own_process_pct",
            "policy",
            "threshold_pct",
            "threshold_total_pct",
            "contaminated"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "mask_busy_other_pct": {
              "type": "number",
              "minimum": 0
            },
            "policy": {
              "enum": [
                "enforce",
                "record"
              ]
            },
            "threshold_pct": {
              "type": "number",
              "minimum": 0
            },
            "contaminated": {
              "type": "boolean"
            },
            "core_mask": {
              "type": "string",
              "pattern": "^0x[0-9a-f]+$"
            },
            "cores": {
              "type": "integer",
              "minimum": 0
            },
            "core_busy_other_pct": {
              "type": "number",
              "minimum": 0
            },
            "threshold_total_pct": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "clock": {
      "type": "object",
      "required": [
        "source",
        "qpc_hz",
        "read_overhead_ns",
        "tsc_hz"
      ],
      "properties": {
        "qpc_hz": {
          "type": "integer",
          "minimum": 1
        },
        "read_overhead_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tsc_hz": {
          "description": "M10: 1e9 / ns_per_tick of the run's TSC calibration (null in M7-M9 manifests or when the calibration failed)",
          "type": [
            "number",
            "null"
          ]
        },
        "tsc_invariant": {
          "type": "boolean"
        },
        "tsc_read_overhead_ns": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "calibration": {
          "type": "object",
          "required": [
            "valid",
            "pairs",
            "span_s",
            "max_residual"
          ]
        }
      }
    },
    "order": {
      "type": "object",
      "required": [
        "repeat_index",
        "order_index",
        "block_seed"
      ],
      "properties": {
        "repeat_index": {
          "type": "integer",
          "minimum": 0
        },
        "order_index": {
          "type": "integer",
          "minimum": 0
        },
        "block_seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "phases_ns": {
      "type": "object",
      "required": [
        "backend_init",
        "option_preflight",
        "scene_create",
        "preflight",
        "prepare",
        "pre_roll",
        "frame0",
        "loop_after_frame0",
        "teardown"
      ]
    },
    "memory": {
      "type": "object",
      "required": [
        "process",
        "backend_scene"
      ]
    },
    "alloc": {
      "type": "object",
      "required": [
        "hook_installed",
        "hook_scope",
        "tick_new_calls",
        "frame0_new_calls",
        "loop_new_calls",
        "backend_allocs_in_loop",
        "backend_allocs_frame0",
        "backend_allocs_after_frame0"
      ],
      "properties": {
        "hook_installed": {
          "type": "boolean"
        },
        "tick_new_calls": {
          "type": "integer",
          "minimum": 0
        },
        "loop_new_calls": {
          "type": "integer",
          "minimum": 0
        },
        "backend_allocs_in_loop": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hook_scope": {
          "type": "string",
          "minLength": 1
        },
        "backend_allocs_frame0": {
          "type": [
            "integer",
            "null"
          ]
        },
        "backend_allocs_after_frame0": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "unit",
        "frame0_frame_ns",
        "windows",
        "cpu_eff"
      ],
      "properties": {
        "unit": {
          "const": "ns"
        },
        "windows": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/window"
          }
        },
        "cpu_eff": {
          "description": "M10: the census window's cpu_eff (null in M7-M9 manifests or without a loop)",
          "type": [
            "number",
            "null"
          ]
        },
        "frame0_frame_ns": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "determinism": {
      "type": "object",
      "required": [
        "h_native",
        "h_native_frame",
        "h_quantized",
        "h_state",
        "engine_error_bits",
        "capacity_error_bits_declared",
        "capacity_error_bits",
        "other_error_bits"
      ],
      "properties": {
        "h_native": {
          "type": "string",
          "pattern": "^(0x[0-9a-f]{16})?$"
        },
        "h_quantized": {
          "type": "string",
          "pattern": "^(0x[0-9a-f]{16})?$"
        },
        "h_state": {
          "type": "string",
          "pattern": "^(0x[0-9a-f]{16})?$"
        },
        "engine_error_bits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "result",
          "checks",
          "failures",
          "notes"
        ],
        "properties": {
          "id": {
            "enum": [
              "G0",
              "G9",
              "G10a",
              "G10b"
            ]
          },
          "result": {
            "enum": [
              "Pass",
              "Fail",
              "Skip"
            ]
          },
          "checks": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "manifest.json"
      }
    },
    "deferred_fields": {
      "type": "object"
    },
    "wall_time_s": {
      "type": "number",
      "minimum": 0
    },
    "step_stats_final": {
      "type": [
        "object",
        "null"
      ]
    },
    "recorders": {
      "type": "object",
      "required": [
        "hashes",
        "states",
        "contacts",
        "phases"
      ],
      "properties": {
        "native_draw": {
          "description": "M9: native_draw.csv of a -Instrument=native_debug_draw run (PT_SNAP_NATIVE_DRAW every 'every' frames: counts per PT_DD_* type, string bytes, truncation, h_draw). frames 0 with a note when the tier is off, the backend lacks PT_CAP_NATIVE_DEBUG_DRAW or the run is not a viz run.",
          "type": "object",
          "required": [
            "frames",
            "commands",
            "truncated_frames",
            "every",
            "note"
          ],
          "properties": {
            "frames": {
              "type": "integer",
              "minimum": 0
            },
            "commands": {
              "type": "integer",
              "minimum": 0
            },
            "truncated_frames": {
              "type": "integer",
              "minimum": 0
            },
            "every": {
              "type": "integer",
              "minimum": 0
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effective": {
      "type": "object",
      "required": [
        "key",
        "native",
        "native_unit",
        "canonical",
        "unit",
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "READBACK",
            "SET_ONLY",
            "COMPILE_TIME",
            "ENGINE_DEFAULT"
          ]
        },
        "canonical": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "stats": {
      "type": "object",
      "required": [
        "count",
        "mean",
        "median",
        "p95",
        "p99",
        "min",
        "max"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "window": {
      "type": "object",
      "required": [
        "first",
        "last",
        "declared_last",
        "clipped",
        "count",
        "frame_ns",
        "step_ns",
        "push_ns",
        "pull_ns"
      ],
      "properties": {
        "first": {
          "type": "integer",
          "minimum": 0
        },
        "last": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "the last frame of the window this run covered (min(declared_last, frames_run - 1)); null when none"
        },
        "declared_last": {
          "type": "integer",
          "minimum": 0
        },
        "clipped": {
          "type": "boolean",
          "description": "the run ended before declared_last"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_ns": {
          "$ref": "#/$defs/stats_or_null"
        },
        "step_ns": {
          "$ref": "#/$defs/stats_or_null"
        },
        "push_ns": {
          "$ref": "#/$defs/stats_or_null"
        },
        "pull_ns": {
          "$ref": "#/$defs/stats_or_null"
        }
      },
      "if": {
        "properties": {
          "count": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "last": {
            "type": "null"
          },
          "frame_ns": {
            "type": "null"
          },
          "step_ns": {
            "type": "null"
          },
          "push_ns": {
            "type": "null"
          },
          "pull_ns": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "last": {
            "type": "integer"
          },
          "frame_ns": {
            "$ref": "#/$defs/stats"
          },
          "step_ns": {
            "$ref": "#/$defs/stats"
          },
          "push_ns": {
            "$ref": "#/$defs/stats"
          },
          "pull_ns": {
            "$ref": "#/$defs/stats"
          }
        }
      }
    },
    "stats_or_null": {
      "oneOf": [
        {
          "$ref": "#/$defs/stats"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "$comment": "M10 (R9): a reportable run (unofficial false) is headline-valid, has a valid conformance stamp and ran under High performance / Ultimate",
      "if": {
        "properties": {
          "unofficial": {
            "const": false
          }
        },
        "required": [
          "unofficial"
        ]
      },
      "then": {
        "properties": {
          "timing_valid_for_headline": {
            "const": true
          },
          "conformance_stamp": {
            "type": "object",
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "valid"
            ]
          },
          "platform": {
            "properties": {
              "power_scheme_high_performance": {
                "const": true
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "unofficial_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scene": {
            "properties": {
              "built": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scene": {
            "properties": {
              "desc_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "options_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "num_bodies": {
                "type": "integer"
              }
            }
          },
          "run": {
            "properties": {
              "frame_driver": {
                "enum": [
                  "Harness",
                  "Native"
                ]
              },
              "sync_policy": {
                "type": "string"
              },
              "async_interpolated": {
                "type": "boolean"
              }
            }
          },
          "step_stats_final": {
            "type": "object"
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "const": "preflight_failed"
          },
          "exit_code": {
            "const": 2
          },
          "preflight_error": {
            "type": "string",
            "pattern": "^engine options: "
          }
        },
        "required": [
          "preflight_error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "$comment": "M8 usage_error: a refused test-only injection is exit code 2",
      "if": {
        "properties": {
          "status": {
            "const": "usage_error"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          },
          "preflight_error": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "preflight_error"
        ]
      }
    },
    {
      "$comment": "M8 headline consistency: timing_valid_for_headline true implies every condition of docs/TimingContract.md 6 (M7 review); M10 (M8 review): also #5 (the four host controls applied), #9 (PT_DO_CHECK 0) and the M10 conditions #11 (no failed G10b, and - M10 fix round 1 - no T = 1 G10b Skip for a missing census or a contended window), #12 (an invariant TSC and a valid TSC / QPC calibration whose residual is below 1e-5, M10 fix round 1) and #13 (not a profiler build). A field an older manifest lacks is not required here.",
      "if": {
        "properties": {
          "timing_valid_for_headline": {
            "const": true
          }
        },
        "required": [
          "timing_valid_for_headline"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "exit_code": {
            "const": 0
          },
          "timing_invalid_reasons": {
            "maxItems": 0
          },
          "run": {
            "properties": {
              "mode": {
                "const": "Bench"
              },
              "instrumentation": {
                "maxItems": 0
              },
              "instrument_flags": {
                "const": 0
              },
              "scene_desc_instrument_flags": {
                "const": 0
              },
              "tick_mode": {
                "const": "FixedStep"
              },
              "hash_every": {
                "const": 0
              },
              "states_every": {
                "const": 0
              },
              "counters_every": {
                "const": 0
              },
              "capture_every": {
                "const": 0
              },
              "pre_roll_s": {
                "type": "number",
                "minimum": 0.5
              },
              "test_injections": {
                "maxProperties": 0
              }
            }
          },
          "alloc": {
            "properties": {
              "tick_new_calls": {
                "const": 0
              }
            },
            "required": [
              "tick_new_calls"
            ]
          },
          "harness": {
            "properties": {
              "do_check": {
                "const": false
              },
              "profiler": {
                "const": false
              }
            }
          },
          "threads": {
            "properties": {
              "affinity_applied": {
                "const": true
              },
              "census_window": {
                "if": {
                  "type": "object",
                  "properties": {
                    "T": {
                      "const": 1
                    }
                  },
                  "required": [
                    "T"
                  ]
                },
                "then": {
                  "properties": {
                    "g10b_skip": {
                      "not": {
                        "enum": [
                          "no_census",
                          "contended"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "clock": {
            "properties": {
              "tsc_invariant": {
                "const": true
              },
              "calibration": {
                "properties": {
                  "valid": {
                    "const": true
                  },
                  "max_residual": {
                    "type": "number",
                    "exclusiveMaximum": 1e-05
                  }
                }
              }
            }
          },
          "gates": {
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "id": {
                    "const": "G10b"
                  },
                  "result": {
                    "const": "Fail"
                  }
                },
                "required": [
                  "id",
                  "result"
                ]
              }
            }
          },
          "platform": {
            "properties": {
              "priority_set": {
                "const": true
              },
              "throttling": {
                "properties": {
                  "opt_out_applied": {
                    "const": true
                  }
                }
              },
              "timer_resolution": {
                "properties": {
                  "applied": {
                    "const": true
                  }
                }
              },
              "host_load": {
                "properties": {
                  "valid": {
                    "const": true
                  },
                  "contaminated": {
                    "const": false
                  }
                },
                "required": [
                  "valid",
                  "contaminated"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "timing_invalid_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
