# CompareBuildFlags.cmake - 03_WorkPlan M0 criterion 4 (risk R6): PhysX must not change any other TU's flags.
#   cmake -DPT_A=out/test/BuildFlags.json -DPT_B=out/test-nophysx/BuildFlags.json -P Tools/CompareBuildFlags.cmake
# A = build with PT_WITH_PHYSX=ON, B = same preset with PT_WITH_PHYSX=OFF. Every TU of B (harness, Jolt, Bullet,
# ImGui) must exist in A with the identical normalised command line (cmd_sha256: the full cl.exe command with the
# build directory replaced by <BIN>), hence identical /arch, /fp, CRT, /std, optimisation and defines.
# TUs that exist only in A must be PhysX TUs or targets that link PT::PhysX.
foreach(_v PT_A PT_B)
	if(NOT EXISTS "${${_v}}")
		message(FATAL_ERROR "CompareBuildFlags: ${_v}='${${_v}}' does not exist")
	endif()
endforeach()

function(_pt_load Path Prefix)
	file(STRINGS "${Path}" _lines REGEX "^\\{\"group\":")
	set(_keys "")
	foreach(_line IN LISTS _lines)
		if(NOT _line MATCHES "\"group\":\"([^\"]*)\",\"target\":\"([^\"]*)\",\"file\":\"([^\"]*)\",.*\"arch\":\"([^\"]*)\",\"fp\":\"([^\"]*)\",\"crt\":\"([^\"]*)\",\"std\":\"([^\"]*)\",.*\"cmd_sha256\":\"([0-9a-f]+)\"")
			message(FATAL_ERROR "CompareBuildFlags: cannot parse line in ${Path}: ${_line}")
		endif()
		string(MD5 _key "${CMAKE_MATCH_3}")
		list(APPEND _keys ${_key})
		set(${Prefix}_${_key} "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}|${CMAKE_MATCH_3}|arch=${CMAKE_MATCH_4}|fp=${CMAKE_MATCH_5}|crt=${CMAKE_MATCH_6}|std=${CMAKE_MATCH_7}" PARENT_SCOPE)
		set(${Prefix}_SHA_${_key} "${CMAKE_MATCH_8}" PARENT_SCOPE)
	endforeach()
	set(${Prefix}_KEYS ${_keys} PARENT_SCOPE)
endfunction()

_pt_load("${PT_A}" A)
_pt_load("${PT_B}" B)

set(_identical 0)
set(_problems "")
set(_groups_checked "")
foreach(_key IN LISTS B_KEYS)
	string(REPLACE "|" ";" _info "${B_${_key}}")
	list(GET _info 0 _group)
	list(GET _info 2 _file)
	list(APPEND _groups_checked ${_group})
	if(NOT DEFINED A_${_key})
		list(APPEND _problems "only in B (PhysX OFF): ${_file}")
	elseif(NOT A_SHA_${_key} STREQUAL B_SHA_${_key})
		list(APPEND _problems "different command: ${_file}\n    ON : ${A_${_key}}\n    OFF: ${B_${_key}}")
	else()
		math(EXPR _identical "${_identical} + 1")
	endif()
endforeach()

set(_only_a 0)
set(_only_a_targets "")
foreach(_key IN LISTS A_KEYS)
	if(NOT DEFINED B_${_key})
		math(EXPR _only_a "${_only_a} + 1")
		string(REPLACE "|" ";" _info "${A_${_key}}")
		list(GET _info 0 _group)
		list(GET _info 1 _target)
		list(APPEND _only_a_targets "${_target}")
		if(NOT _group STREQUAL "sdk.physx" AND NOT _target MATCHES "PhysX")
			list(GET _info 2 _file)
			list(APPEND _problems "only in A but not a PhysX TU: ${_file}")
		endif()
	endif()
endforeach()
list(REMOVE_DUPLICATES _only_a_targets)
list(REMOVE_DUPLICATES _groups_checked)
list(LENGTH B_KEYS _n_b)
list(LENGTH A_KEYS _n_a)

message(STATUS "A (PhysX ON) : ${PT_A} - ${_n_a} TUs")
message(STATUS "B (PhysX OFF): ${PT_B} - ${_n_b} TUs, groups ${_groups_checked}")
message(STATUS "Identical normalised commands: ${_identical} / ${_n_b}")
message(STATUS "Only in A: ${_only_a} TUs in targets ${_only_a_targets}")
if(_problems)
	string(REPLACE ";" "\n" _text "${_problems}")
	message(FATAL_ERROR "CompareBuildFlags: FAIL\n${_text}")
endif()
message(STATUS "CompareBuildFlags: PASS")
