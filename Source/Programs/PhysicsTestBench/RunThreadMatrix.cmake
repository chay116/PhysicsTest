# RunThreadMatrix.cmake - 03_WorkPlan M7 thread mapping (02 9.6): "Jolt와 PhysX의 T=1..6 run과 Bullet T=1 run이 끝까지 돌고
# affinity 마스크가 기록된다. 스케일링 수치에는 'cpu_eff 미검증 (M10)' 표기가 붙는다."
# Every run must exit 0 with frames_run = frames; the manifest's threads.affinity_mask must be the first T P-core logical
# CPUs of platform.p_cores (0x1, 0x5, 0x15, 0x55, 0x155, 0x555 on the i5-13600KF), threads.engine_native.workers the
# engine's mapping (Jolt T - 1 job threads; PhysX 0 for the T = 1 inline dispatcher, T for PxDefaultCpuDispatcherCreate(T)),
# and T > 1 carries the scaling note "cpu_eff 미검증 (M10)". Bullet T = 2 must be refused (exit 2: no PT_CAP_MULTITHREADED).
# Short runs (PT_FRAMES frames, no pre-roll); the scaling numbers themselves are a manual, UNOFFICIAL step (Progress M7).
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> -DPT_ENGINES=Jolt,PhysX -DPT_BULLET=ON -DPT_FRAMES=10 [-DPT_MAX_T=6] -P RunThreadMatrix.cmake
cmake_minimum_required(VERSION 3.25)
if(NOT PT_FRAMES)
	set(PT_FRAMES 10)
endif()
if(NOT PT_MAX_T)
	set(PT_MAX_T 6)
endif()
file(REMOVE_RECURSE "${PT_OUT_DIR}")
set(_failures "")
set(_lines "")
string(REPLACE "," ";" _engines "${PT_ENGINES}")

function(_pt_run_thread_case Engine T ExpectRc OutVar)
	set(_dir "${PT_OUT_DIR}/${Engine}_T${T}")
	execute_process(COMMAND "${PT_BENCH_EXE}" "-Backend=${Engine}" -Scenario=M3.BoxPile -Param:N=1000 "-Frames=${PT_FRAMES}" "-Threads=${T}" -PreRoll=0
			-HostCheck=record "-Out=${_dir}"
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 600)
	set(${OutVar} "${_dir}" PARENT_SCOPE)
	if(NOT _rc EQUAL ${ExpectRc})
		set(_failures ${_failures} "${Engine} T=${T}: exit code ${_rc}, expected ${ExpectRc}\n${_stdout}${_stderr}" PARENT_SCOPE)
	endif()
endfunction()

set(_cases "")
foreach(_engine IN LISTS _engines)
	foreach(_t RANGE 1 ${PT_MAX_T})
		list(APPEND _cases "${_engine}|${_t}")
	endforeach()
endforeach()
if(PT_BULLET)
	list(APPEND _cases "Bullet|1")
endif()
foreach(_case IN LISTS _cases)
	string(REPLACE "|" ";" _parts "${_case}")
	list(GET _parts 0 _engine)
	list(GET _parts 1 _t)
	_pt_run_thread_case(${_engine} ${_t} 0 _dir)
	if(NOT EXISTS "${_dir}/manifest.json")
		list(APPEND _failures "${_engine} T=${_t}: manifest.json missing")
		continue()
	endif()
	file(READ "${_dir}/manifest.json" _manifest)
	string(JSON _mask ERROR_VARIABLE _err GET "${_manifest}" threads affinity_mask)
	string(JSON _applied ERROR_VARIABLE _err GET "${_manifest}" threads affinity_applied)
	string(JSON _workers ERROR_VARIABLE _err GET "${_manifest}" threads engine_native workers)
	string(JSON _note ERROR_VARIABLE _err GET "${_manifest}" threads scaling_note)
	string(JSON _frames_run ERROR_VARIABLE _err GET "${_manifest}" run frames_run)
	string(JSON _num_p ERROR_VARIABLE _err LENGTH "${_manifest}" platform p_cores)
	# The expected mask: the first T P-core logical CPUs of this machine.
	set(_expected 0)
	math(EXPR _last "${_t} - 1")
	foreach(_index RANGE 0 ${_last})
		string(JSON _cpu ERROR_VARIABLE _err GET "${_manifest}" platform p_cores ${_index})
		math(EXPR _expected "${_expected} | (1 << ${_cpu})")
	endforeach()
	math(EXPR _expected_hex "${_expected}" OUTPUT_FORMAT HEXADECIMAL)
	string(TOLOWER "${_expected_hex}" _expected_hex)
	if(NOT _mask STREQUAL _expected_hex OR NOT _applied STREQUAL "ON")
		list(APPEND _failures "${_engine} T=${_t}: affinity_mask '${_mask}' (applied ${_applied}), expected ${_expected_hex}")
	endif()
	if(NOT _frames_run EQUAL PT_FRAMES)
		list(APPEND _failures "${_engine} T=${_t}: frames_run ${_frames_run} of ${PT_FRAMES}")
	endif()
	if(_engine STREQUAL "Jolt")
		math(EXPR _expected_workers "${_t} - 1")
	elseif(_engine STREQUAL "PhysX")
		if(_t EQUAL 1)
			set(_expected_workers 0)
		else()
			set(_expected_workers ${_t})
		endif()
	else()
		set(_expected_workers 0)
	endif()
	if(NOT _workers EQUAL _expected_workers)
		list(APPEND _failures "${_engine} T=${_t}: threads.workers ${_workers}, expected ${_expected_workers} (02 9.6)")
	endif()
	if(_t GREATER 1 AND NOT _note MATCHES "cpu_eff 미검증 [(]M10[)]")
		list(APPEND _failures "${_engine} T=${_t}: the scaling note is missing: '${_note}'")
	endif()
	list(APPEND _lines "${_engine} T=${_t}: mask ${_mask}, workers ${_workers}")
endforeach()
if(PT_BULLET)
	_pt_run_thread_case(Bullet 2 2 _dir)
	if(EXISTS "${_dir}/exit.json")
		file(READ "${_dir}/exit.json" _exit)
		string(JSON _reason ERROR_VARIABLE _err GET "${_exit}" reason)
		if(NOT _reason MATCHES "PT_CAP_MULTITHREADED")
			list(APPEND _failures "Bullet T=2: exit.json reason '${_reason}'")
		endif()
		list(APPEND _lines "Bullet T=2: refused (${_reason})")
	else()
		list(APPEND _failures "Bullet T=2: exit.json missing")
	endif()
endif()
if(_failures)
	string(REPLACE ";" "\n  " _text "${_failures}")
	message(FATAL_ERROR "thread matrix failures:\n  ${_text}")
endif()
string(REPLACE ";" "\n  " _text "${_lines}")
message(STATUS "PASS: thread matrix\n  ${_text}")
