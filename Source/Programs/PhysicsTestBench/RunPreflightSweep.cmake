# RunPreflightSweep.cmake - M7: the bench preflight (required keys, G0, G9, G10a) passes on EVERY registered scene (default
# parameters) x backend / variant x physics profile, not only on the scenes the other tests use. G9 runs on the run's own
# effective dump: rules bound to M3.BoxPile's geometry (tolerances.json "scene"), body-template rules on scenes that pin
# their bodies' values and per-body aggregates of a scene without dynamic bodies are skipped with a note (docs/Progress.md
# M7). S08.StartAsleep under Normalized is refused by design (exit 2, RequiresSleeping). Two frames per run.
# M9: a scene that requires capabilities (-List required_capabilities: the joint scenes M6a / M6b / M6c need PT_CAP_JOINT_*) is
# refused with exit 2 and status "unsupported" by a backend that lacks them. M9 fix round 0: what is tolerated is data-driven -
# each entry's declared capabilities come from -Describe: a scene whose required capabilities the entry does not declare
# must be refused as "unsupported" (tolerated and listed: Null today, a Chaos bridge before its joints exist); a scene whose
# capabilities it declares must pass the normal preflight (a refusal is a failure). Whether the SDK engines declare the joint
# types is checked by the joint gate J1 (PhysicsTest.Joint.BackendContract), not here.
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> "-DPT_BACKEND=Jolt,Bullet,PhysX/UE4Compat" -P RunPreflightSweep.cmake
cmake_minimum_required(VERSION 3.25)
file(REMOVE_RECURSE "${PT_OUT_DIR}")
execute_process(COMMAND "${PT_BENCH_EXE}" -List OUTPUT_VARIABLE _list ERROR_VARIABLE _ignored RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
	message(FATAL_ERROR "-List failed (${_rc})")
endif()
string(JSON _num_scenes LENGTH "${_list}" scenarios)
math(EXPR _last_scene "${_num_scenes} - 1")
set(_scenes "")
set(_capability_scenes "")
foreach(_index RANGE 0 ${_last_scene})
	string(JSON _name GET "${_list}" scenarios ${_index} name)
	list(APPEND _scenes "${_name}")
	string(JSON _num_caps LENGTH "${_list}" scenarios ${_index} required_capabilities)
	set(_required "")
	if(_num_caps GREATER 0)
		list(APPEND _capability_scenes "${_name}")
		math(EXPR _last_cap "${_num_caps} - 1")
		foreach(_cap_index RANGE 0 ${_last_cap})
			string(JSON _cap GET "${_list}" scenarios ${_index} required_capabilities ${_cap_index})
			list(APPEND _required "${_cap}")
		endforeach()
	endif()
	string(MAKE_C_IDENTIFIER "${_name}" _scene_id)
	set(_required_${_scene_id} "${_required}")
endforeach()
set(_unsupported "")
string(REPLACE "," ";" _entries "${PT_BACKEND}")
set(_failures "")
# The declared capabilities of every entry (-Describe backend.capabilities: names without PT_CAP_).
foreach(_entry Null ${_entries})
	string(REPLACE "/" ";" _entry_parts "${_entry}")
	list(GET _entry_parts 0 _backend)
	set(_variant_args "")
	list(LENGTH _entry_parts _entry_parts_count)
	if(_entry_parts_count GREATER 1)
		list(GET _entry_parts 1 _variant)
		set(_variant_args "-BackendProfile=${_variant}")
	endif()
	execute_process(COMMAND "${PT_BENCH_EXE}" -Describe "-Backend=${_backend}" ${_variant_args} OUTPUT_VARIABLE _describe ERROR_VARIABLE _ignored RESULT_VARIABLE _rc)
	string(JSON _num_declared ERROR_VARIABLE _describe_err LENGTH "${_describe}" backend capabilities)
	if(NOT _rc EQUAL 0 OR _describe_err)
		message(FATAL_ERROR "-Describe -Backend=${_backend} ${_variant_args} failed (${_rc}): ${_describe_err}")
	endif()
	set(_declared "")
	if(_num_declared GREATER 0)
		math(EXPR _last_declared "${_num_declared} - 1")
		foreach(_cap_index RANGE 0 ${_last_declared})
			string(JSON _cap GET "${_describe}" backend capabilities ${_cap_index})
			list(APPEND _declared "${_cap}")
		endforeach()
	endif()
	string(MAKE_C_IDENTIFIER "${_entry}" _entry_id)
	set(_declared_${_entry_id} "${_declared}")
endforeach()
set(_runs 0)
set(_refused 0)
foreach(_scene IN LISTS _scenes)
	foreach(_profile Normalized UEParity)
		foreach(_entry Null ${_entries})
			string(REPLACE "/" ";" _entry_parts "${_entry}")
			list(GET _entry_parts 0 _backend)
			set(_variant_args "")
			set(_entry_tag "${_backend}")
			list(LENGTH _entry_parts _entry_parts_count)
			if(_entry_parts_count GREATER 1)
				list(GET _entry_parts 1 _variant)
				set(_variant_args "-BackendProfile=${_variant}")
				set(_entry_tag "${_backend}-${_variant}")
			endif()
			set(_dir "${PT_OUT_DIR}/${_scene}_${_profile}_${_entry_tag}")
			execute_process(COMMAND "${PT_BENCH_EXE}" "-Backend=${_backend}" ${_variant_args} "-Profile=${_profile}" "-Scenario=${_scene}" -Frames=2 -PreRoll=0
					-HostCheck=record "-Out=${_dir}"
				RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
			math(EXPR _runs "${_runs} + 1")
			set(_reason "")
			set(_status "")
			if(EXISTS "${_dir}/exit.json")
				file(READ "${_dir}/exit.json" _exit)
				string(JSON _reason ERROR_VARIABLE _err GET "${_exit}" reason)
				string(JSON _status ERROR_VARIABLE _err GET "${_exit}" status)
			endif()
			# Does the entry declare every capability the scene requires?
			string(MAKE_C_IDENTIFIER "${_scene}" _scene_id)
			string(MAKE_C_IDENTIFIER "${_entry}" _entry_id)
			set(_missing "")
			foreach(_cap IN LISTS _required_${_scene_id})
				if(NOT _cap IN_LIST _declared_${_entry_id})
					list(APPEND _missing "${_cap}")
				endif()
			endforeach()
			if(_rc EQUAL 2 AND _status STREQUAL "unsupported")
				if(_missing)
					list(APPEND _unsupported "${_scene} ${_profile} ${_entry} (lacks ${_missing})")   # listed below
				elseif(_scene IN_LIST _capability_scenes)
					list(APPEND _failures "${_scene} ${_profile} ${_entry}: refused as unsupported although -Describe declares every required capability (${_required_${_scene_id}}): ${_reason}")
				else()
					list(APPEND _failures "${_scene} ${_profile} ${_entry}: refused as unsupported but the scene requires no capability: ${_reason}")
				endif()
			elseif(_missing)
				list(APPEND _failures "${_scene} ${_profile} ${_entry}: the entry lacks ${_missing} but the run was not refused as unsupported (exit ${_rc}, status '${_status}')")
			elseif(_scene STREQUAL "S08.StartAsleep" AND _profile STREQUAL "Normalized")
				if(NOT _rc EQUAL 2 OR NOT _reason MATCHES "needs a profile with sleeping allowed")
					list(APPEND _failures "${_scene} ${_profile} ${_entry}: expected the RequiresSleeping refusal, got ${_rc}: ${_reason}")
				endif()
				math(EXPR _refused "${_refused} + 1")
			elseif(NOT _rc EQUAL 0)
				list(APPEND _failures "${_scene} ${_profile} ${_entry}: exit code ${_rc}: ${_reason}")
			endif()
		endforeach()
	endforeach()
endforeach()
if(_failures)
	string(REPLACE ";" "\n  " _text "${_failures}")
	message(FATAL_ERROR "preflight sweep failures:\n  ${_text}")
endif()
list(LENGTH _scenes _num)
list(LENGTH _unsupported _num_unsupported)
if(_unsupported)
	string(REPLACE ";" "\n  " _unsupported_text "${_unsupported}")
	message(STATUS "M9: ${_num_unsupported} run(s) refused as unsupported (the entry does not declare a capability the scene requires, per -Describe):\n  "
		"${_unsupported_text}")
endif()
message(STATUS "PASS: ${_runs} runs (${_num} scenes x 2 profiles x Null + ${PT_BACKEND}): every preflight passed; ${_refused} S08 / Normalized runs refused as "
	"designed, ${_num_unsupported} unsupported (capability not declared)")
