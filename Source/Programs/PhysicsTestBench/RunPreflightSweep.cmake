# RunPreflightSweep.cmake - M7: the bench preflight (required keys, G0, G9, G10a) passes on EVERY registered scene (default
# parameters) x backend / variant x physics profile, not only on the scenes the other tests use. G9 runs on the run's own
# effective dump: rules bound to M3.BoxPile's geometry (tolerances.json "scene"), body-template rules on scenes that pin
# their bodies' values and per-body aggregates of a scene without dynamic bodies are skipped with a note (docs/Progress.md
# M7). S08.StartAsleep under Normalized is refused by design (exit 2, RequiresSleeping). Two frames per run.
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> "-DPT_BACKEND=Jolt,Bullet,PhysX/UE4Compat" -P RunPreflightSweep.cmake
cmake_minimum_required(VERSION 3.25)
file(REMOVE_RECURSE "${PT_OUT_DIR}")
execute_process(COMMAND "${PT_BENCH_EXE}" -List OUTPUT_VARIABLE _list ERROR_VARIABLE _ignored RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
	message(FATAL_ERROR "-List failed (${_rc})")
endif()
string(JSON _num_scenes LENGTH "${_list}" scenarios)
math(EXPR _last_scene "${_num_scenes} - 1")
set(_scenes "")
foreach(_index RANGE 0 ${_last_scene})
	string(JSON _name GET "${_list}" scenarios ${_index} name)
	list(APPEND _scenes "${_name}")
endforeach()
string(REPLACE "," ";" _entries "${PT_BACKEND}")
set(_failures "")
set(_runs 0)
set(_refused 0)
foreach(_scene IN LISTS _scenes)
	foreach(_profile Normalized UEParity)
		foreach(_entry Null ${_entries})
			string(REPLACE "/" ";" _entry_parts "${_entry}")
			list(GET _entry_parts 0 _backend)
			set(_variant_args "")
			set(_entry_tag "${_backend}")
			list(LENGTH _entry_parts _entry_parts_count)
			if(_entry_parts_count GREATER 1)
				list(GET _entry_parts 1 _variant)
				set(_variant_args "-BackendProfile=${_variant}")
				set(_entry_tag "${_backend}-${_variant}")
			endif()
			set(_dir "${PT_OUT_DIR}/${_scene}_${_profile}_${_entry_tag}")
			execute_process(COMMAND "${PT_BENCH_EXE}" "-Backend=${_backend}" ${_variant_args} "-Profile=${_profile}" "-Scenario=${_scene}" -Frames=2 -PreRoll=0
					-HostCheck=record "-Out=${_dir}"
				RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
			math(EXPR _runs "${_runs} + 1")
			set(_reason "")
			if(EXISTS "${_dir}/exit.json")
				file(READ "${_dir}/exit.json" _exit)
				string(JSON _reason ERROR_VARIABLE _err GET "${_exit}" reason)
			endif()
			if(_scene STREQUAL "S08.StartAsleep" AND _profile STREQUAL "Normalized")
				if(NOT _rc EQUAL 2 OR NOT _reason MATCHES "needs a profile with sleeping allowed")
					list(APPEND _failures "${_scene} ${_profile} ${_entry}: expected the RequiresSleeping refusal, got ${_rc}: ${_reason}")
				endif()
				math(EXPR _refused "${_refused} + 1")
			elseif(NOT _rc EQUAL 0)
				list(APPEND _failures "${_scene} ${_profile} ${_entry}: exit code ${_rc}: ${_reason}")
			endif()
		endforeach()
	endforeach()
endforeach()
if(_failures)
	string(REPLACE ";" "\n  " _text "${_failures}")
	message(FATAL_ERROR "preflight sweep failures:\n  ${_text}")
endif()
list(LENGTH _scenes _num)
message(STATUS "PASS: ${_runs} runs (${_num} scenes x 2 profiles x Null + ${PT_BACKEND}): every preflight passed; ${_refused} S08 / Normalized runs refused as designed")
