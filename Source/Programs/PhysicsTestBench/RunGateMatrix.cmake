# RunGateMatrix.cmake - 03_WorkPlan M7: the multi-process gates through the bench exe, for Null, the Null DLL and every SDK
# backend / variant.
#   G8 (DET1)  "모든 백엔드·변형에서 T=1 fresh process 3회의 최종 h_native가 같다": -Gate=G8 -Runs=3 must pass (exit 0,
#              gate_g8.json result pass, three child runs with equal final h_native and h_state)
#   G11        "접촉 캡처를 켜고 끈 M3.BoxPile 1k 600 프레임의 상태가 모든 백엔드에서 비트 단위로 같다": -Gate=G11 must pass (every
#              frame's h_native and h_state equal with contact capture off and on)
# The CTest runs are short (PT_FRAMES frames, no pre-roll); the 600-frame evidence runs are a manual step (docs/Progress.md
# M7).
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> -DPT_GATE=G8|G11 "-DPT_BACKEND=Jolt,Bullet,PhysX/UE4Compat" -DPT_FRAMES=60
#         [-DPT_SCENE=M3.BoxPile] [-DPT_PARAM=N=1000] [-DPT_PROFILE=Normalized] -P RunGateMatrix.cmake
cmake_minimum_required(VERSION 3.25)
foreach(_req PT_BENCH_EXE PT_OUT_DIR PT_GATE)
	if(NOT DEFINED ${_req})
		message(FATAL_ERROR "RunGateMatrix.cmake: -D${_req}=... is required")
	endif()
endforeach()
if(NOT PT_FRAMES)
	set(PT_FRAMES 60)
endif()
if(NOT PT_SCENE)
	set(PT_SCENE M3.BoxPile)
endif()
if(NOT PT_PARAM)
	set(PT_PARAM N=1000)
endif()
if(NOT PT_PROFILE)
	set(PT_PROFILE Normalized)
endif()
string(TOLOWER "${PT_GATE}" _gate_lower)
file(REMOVE_RECURSE "${PT_OUT_DIR}")
set(_failures "")
set(_passed "")
string(REPLACE "," ";" _entries "${PT_BACKEND}")
foreach(_entry Null NullDll ${_entries})
	string(REPLACE "/" ";" _entry_parts "${_entry}")
	list(GET _entry_parts 0 _backend)
	set(_variant_args "")
	set(_entry_tag "${_backend}")
	list(LENGTH _entry_parts _entry_parts_count)
	if(_entry_parts_count GREATER 1)
		list(GET _entry_parts 1 _variant)
		set(_variant_args "-BackendProfile=${_variant}")
		set(_entry_tag "${_backend}-${_variant}")
	endif()
	set(_dir "${PT_OUT_DIR}/${_entry_tag}")
	execute_process(COMMAND "${PT_BENCH_EXE}" "-Gate=${PT_GATE}" -Runs=3 "-Backend=${_backend}" ${_variant_args} "-Profile=${PT_PROFILE}" "-Scenario=${PT_SCENE}"
			"-Param:${PT_PARAM}" "-Frames=${PT_FRAMES}" -PreRoll=0 "-Out=${_dir}"
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 1200)
	set(_label "${PT_GATE} ${_entry} ${PT_PROFILE} ${PT_SCENE} ${PT_PARAM}")
	if(NOT EXISTS "${_dir}/gate_${_gate_lower}.json")
		list(APPEND _failures "${_label}: exit code ${_rc}, no gate_${_gate_lower}.json\n${_stdout}${_stderr}")
		continue()
	endif()
	file(READ "${_dir}/gate_${_gate_lower}.json" _json)
	string(JSON _result ERROR_VARIABLE _err GET "${_json}" result)
	string(JSON _num_runs ERROR_VARIABLE _err LENGTH "${_json}" runs)
	string(JSON _h0 ERROR_VARIABLE _err GET "${_json}" runs 0 h_native)
	string(JSON _s0 ERROR_VARIABLE _err GET "${_json}" runs 0 h_state)
	string(JSON _notes ERROR_VARIABLE _err GET "${_json}" notes)
	if(NOT _rc EQUAL 0 OR NOT _result STREQUAL "pass")
		string(JSON _gate_failures ERROR_VARIABLE _err GET "${_json}" failures)
		list(APPEND _failures "${_label}: exit code ${_rc}, result '${_result}': ${_gate_failures}")
		continue()
	endif()
	if(NOT EXISTS "${_dir}/exit.json")
		list(APPEND _failures "${_label}: exit.json missing")
	endif()
	message(STATUS "${_label}: pass (${_num_runs} fresh processes; h_native ${_h0}, h_state ${_s0}) ${_notes}")
	list(APPEND _passed "${_entry}")
endforeach()
if(_failures)
	string(REPLACE ";" "\n  " _text "${_failures}")
	message(FATAL_ERROR "${PT_GATE} failures:\n  ${_text}")
endif()
string(REPLACE ";" ", " _passed_text "${_passed}")
message(STATUS "PASS: ${PT_GATE} on ${_passed_text} (${PT_SCENE} ${PT_PARAM}, ${PT_PROFILE}, ${PT_FRAMES} frames)")
