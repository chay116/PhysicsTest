# RunHeadlineControl.cmake - the headline positive control (M8, M7 review): a protocol-conformant bench run is headline-valid.
# One Null S00.FreeFall run with the measurement protocol's own settings (tier 0, Bench mode, pre-roll 0.5 s, no recorder, no
# injection). Under CTest the host check is record-only (parallel tests share CPU 0, docs/TimingContract.md 5.1), so the only
# reasons this machine and preset may still give are:
#   "contaminated host (recorded only: -HostCheck=record)"   another process used the run's core (any preset)
#   "checks compiled in (PT_DO_CHECK=1, ...)"                 dev / dbg (harness.do_check true)
# Any other reason fails the test (a regression that always sets timing_valid_for_headline false would show here). A run
# without either reason must say timing_valid_for_headline true.
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> -P RunHeadlineControl.cmake
cmake_minimum_required(VERSION 3.25)
file(REMOVE_RECURSE "${PT_OUT_DIR}")
execute_process(COMMAND "${PT_BENCH_EXE}" -Backend=Null -Scenario=S00.FreeFall -Frames=10 -PreRoll=0.5 -HostCheck=record "-Out=${PT_OUT_DIR}"
	RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr TIMEOUT 120)
if(NOT _rc EQUAL 0)
	message(FATAL_ERROR "the control run exited ${_rc}\n${_stdout}${_stderr}")
endif()
file(READ "${PT_OUT_DIR}/manifest.json" _manifest)
string(JSON _valid GET "${_manifest}" timing_valid_for_headline)
string(JSON _do_check GET "${_manifest}" harness do_check)
string(JSON _contaminated GET "${_manifest}" platform host_load contaminated)
string(JSON _count LENGTH "${_manifest}" timing_invalid_reasons)
set(_expected 0)
if(_contaminated)
	math(EXPR _expected "${_expected} + 1")
endif()
if(_do_check)
	math(EXPR _expected "${_expected} + 1")
endif()
set(_reasons "")
if(_count GREATER 0)
	math(EXPR _last "${_count} - 1")
	foreach(_index RANGE 0 ${_last})
		string(JSON _reason GET "${_manifest}" timing_invalid_reasons ${_index})
		string(APPEND _reasons "\n  ${_reason}")
		if(_reason MATCHES "^contaminated host [(]recorded only: -HostCheck=record[)]$" AND _contaminated)
			continue()
		endif()
		if(_reason MATCHES "^checks compiled in [(]PT_DO_CHECK=1" AND _do_check)
			continue()
		endif()
		message(FATAL_ERROR "unexpected headline reason '${_reason}' (do_check ${_do_check}, contaminated ${_contaminated}):${_reasons}")
	endforeach()
endif()
if(NOT _count EQUAL _expected)
	message(FATAL_ERROR "${_count} reason(s), expected ${_expected} (do_check ${_do_check}, contaminated ${_contaminated}):${_reasons}")
endif()
if(_expected EQUAL 0 AND NOT _valid)
	message(FATAL_ERROR "no reason, but timing_valid_for_headline is ${_valid}")
endif()
if(_expected GREATER 0 AND _valid)
	message(FATAL_ERROR "timing_valid_for_headline true with ${_expected} expected reason(s)")
endif()
message(STATUS "headline control: timing_valid_for_headline ${_valid}, do_check ${_do_check}, contaminated ${_contaminated}, reasons:${_reasons}")
