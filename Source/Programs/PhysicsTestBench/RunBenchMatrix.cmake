# RunBenchMatrix.cmake - 03_WorkPlan M3 / M5 criteria: PhysicsTestBench.exe runs M1.SingleBoxDrop a/b and M3.BoxPile 1k/5k
# under UEParity and Normalized and writes timings.csv, manifest.json and effective_settings.jsonl; desc_sha256 is the
# same for Null and every SDK backend / variant (M5: "desc_sha256이 jolt, bullet, physx 변형 4종에서 씬·프로필마다 같다");
# shape.wrapping is 0; the timings are marked unofficial. Short runs (PT_FRAMES frames) keep the CTest fast in every
# preset; the full-length runs are a manual step (docs/Progress.md M3, M5).
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> "-DPT_BACKEND=Jolt,Bullet,PhysX/UE4Compat" -DPT_FRAMES=30 -P RunBenchMatrix.cmake
# PT_BACKEND: a comma list of <Backend> or <Backend>/<Variant> (-BackendProfile=<Variant>); empty = Null only.
cmake_minimum_required(VERSION 3.25)
if(NOT PT_FRAMES)
	set(PT_FRAMES 30)
endif()
file(REMOVE_RECURSE "${PT_OUT_DIR}")
set(_cases "M1.SingleBoxDrop|Case=a" "M1.SingleBoxDrop|Case=b" "M3.BoxPile|N=1000" "M3.BoxPile|N=5000")
set(_failures "")
set(_runs 0)
string(REPLACE "," ";" _entries "${PT_BACKEND}")

function(_pt_json_get _out _json)
	string(JSON _value ERROR_VARIABLE _err GET "${_json}" ${ARGN})
	if(_err)
		set(${_out} "<missing: ${ARGN}>" PARENT_SCOPE)
	else()
		set(${_out} "${_value}" PARENT_SCOPE)
	endif()
endfunction()

foreach(_profile UEParity Normalized)
	foreach(_case IN LISTS _cases)
		string(REPLACE "|" ";" _parts "${_case}")
		list(GET _parts 0 _scene)
		list(GET _parts 1 _param)
		string(REPLACE "=" "" _tag "${_param}")
		set(_reference "")
		set(_equal "")
		foreach(_entry Null ${_entries})
			string(REPLACE "/" ";" _entry_parts "${_entry}")
			list(GET _entry_parts 0 _backend)
			set(_variant_args "")
			set(_entry_tag "${_backend}")
			list(LENGTH _entry_parts _entry_parts_count)
			if(_entry_parts_count GREATER 1)
				list(GET _entry_parts 1 _variant)
				set(_variant_args "-BackendProfile=${_variant}")
				set(_entry_tag "${_backend}-${_variant}")
			endif()
			set(_dir "${PT_OUT_DIR}/${_entry_tag}_${_profile}_${_scene}_${_tag}")
			execute_process(COMMAND "${PT_BENCH_EXE}" "-Backend=${_backend}" ${_variant_args} "-Profile=${_profile}" "-Scenario=${_scene}" "-Param:${_param}"
					"-Frames=${PT_FRAMES}" "-Out=${_dir}"
				RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
			math(EXPR _runs "${_runs} + 1")
			set(_label "${_entry} ${_profile} ${_scene} ${_param}")
			if(NOT _rc EQUAL 0)
				list(APPEND _failures "${_label}: exit code ${_rc}\n${_stdout}${_stderr}")
				continue()
			endif()
			foreach(_file timings.csv manifest.json effective_settings.jsonl)
				if(NOT EXISTS "${_dir}/${_file}")
					list(APPEND _failures "${_label}: ${_file} missing")
				endif()
			endforeach()
			if(NOT EXISTS "${_dir}/manifest.json")
				continue()
			endif()
			file(STRINGS "${_dir}/timings.csv" _rows)
			list(LENGTH _rows _row_count)
			math(EXPR _expected_rows "${PT_FRAMES} + 1")
			if(NOT _row_count EQUAL _expected_rows)
				list(APPEND _failures "${_label}: timings.csv has ${_row_count} lines, expected ${_expected_rows}")
			endif()
			file(READ "${_dir}/manifest.json" _manifest)
			_pt_json_get(_status "${_manifest}" status)
			_pt_json_get(_unofficial "${_manifest}" unofficial)
			_pt_json_get(_headline "${_manifest}" timing_valid_for_headline)
			_pt_json_get(_desc "${_manifest}" scene desc_sha256)
			_pt_json_get(_name "${_manifest}" backend name)
			if(NOT _status STREQUAL "ok" OR NOT _unofficial STREQUAL "ON" OR NOT _headline STREQUAL "OFF")
				list(APPEND _failures "${_label}: status '${_status}', unofficial '${_unofficial}', timing_valid_for_headline '${_headline}'")
			endif()
			string(LENGTH "${_desc}" _desc_length)
			if(NOT _desc_length EQUAL 64 OR NOT _name STREQUAL _backend)
				list(APPEND _failures "${_label}: desc_sha256 '${_desc}' / backend '${_name}'")
			endif()
			# desc_sha256 (02 12.1): the scene description, independent of the engine and its variant.
			if(_entry STREQUAL "Null")
				set(_reference "${_desc}")
			elseif(NOT _desc STREQUAL _reference)
				list(APPEND _failures "${_label}: desc_sha256 ${_desc} differs from Null ${_reference}")
			else()
				list(APPEND _equal "${_entry}")
			endif()
			# shape.wrapping (02 8.1, DL42): the canonical value must be 0 for these scenes.
			file(STRINGS "${_dir}/effective_settings.jsonl" _wrapping REGEX "\"key\":\"shape.wrapping\"")
			if(NOT _wrapping MATCHES "\"canonical\":0[,}]")
				list(APPEND _failures "${_label}: shape.wrapping is not 0: ${_wrapping}")
			endif()
		endforeach()
		string(REPLACE ";" " = " _equal_text "${_equal}")
		if(_equal)
			set(_equal_text " = ${_equal_text}")
		endif()
		message(STATUS "${_profile} ${_scene} ${_param}: desc_sha256 ${_reference} (Null${_equal_text})")
	endforeach()
endforeach()
if(_failures)
	string(REPLACE ";" "\n  " _text "${_failures}")
	message(FATAL_ERROR "bench matrix failures:\n  ${_text}")
endif()
set(_all Null ${_entries})
string(REPLACE ";" " = " _all "${_all}")
message(STATUS "PASS: ${_runs} bench runs (${PT_FRAMES} frames) wrote timings.csv / manifest.json / effective_settings.jsonl, shape.wrapping 0, desc_sha256 ${_all}")
