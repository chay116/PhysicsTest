# RunConformanceMatrix.cmake - 03_WorkPlan M6 criterion: "PhysicsTestBench -Conformance가 위 조합마다 conformance.json을
# 남긴다". One fresh bench process per backend x variant x physics profile (Null, Jolt.Default, Bullet.Default and the four
# PhysX variants in UEParity and Normalized: the PhysX SdkDefault runs get their own PxTolerancesScale): each must exit 0,
# write conformance.json (schema physicstest.conformance/1) with result "pass", no failed gate and the full gate list,
# and record the tolerances file's SHA-256, the ABI version 1.1 and the post-run registrations its verdicts used (with
# pending_sign_offs = how many still wait for the lead, M6 round 2; 0 since the M9 commit). -Describe's stdout must be pure JSON for Null and for
# every SDK entry (their module and scene initialisation are what would print), and so must -List (M6, lead (g)).
# The PT_MODULE_NO_REINIT path (docs/Abi.md 9.1 decision 7, the Chaos bridge's) runs on the test double PtBackend_Null.dll
# with PT_NULL_DLL_NO_REINIT=1: every ABI gate A0-A7, A10 in its own process, the physics gates in one more, and the bench
# must refuse a gate list that would initialise the module twice (exit 2).
#   cmake -DPT_BENCH_EXE=<exe> -DPT_OUT_DIR=<dir> "-DPT_BACKEND=Jolt,Bullet,PhysX/UE4Compat" -P RunConformanceMatrix.cmake
# PT_BACKEND: a comma list of <Backend> or <Backend>/<Variant>; Null and NullDll (the DLL path) always run.
cmake_minimum_required(VERSION 3.25)
file(REMOVE_RECURSE "${PT_OUT_DIR}")
set(_failures "")
set(_runs 0)
# M10: G10b (a fresh T = 1 bench run of the configuration) follows the in-process gates. M10 fix round 0: a DLL backend's suite
# (NullDll here) starts with the ABI gates, one fresh process each, so its stamp certifies them on that DLL.
set(_expected_gates G1 G1b G2 G3 G4 G5 G6 G7 G9 J1 G12 G10b)
set(_abi_suite_gates A0 A1 A2 A3 A4 A5 A6 A7 A10)
string(REPLACE "," ";" _entries "${PT_BACKEND}")

foreach(_entry Null NullDll ${_entries})
	string(REPLACE "/" ";" _entry_parts "${_entry}")
	list(GET _entry_parts 0 _backend)
	set(_variant_args "")
	set(_entry_tag "${_backend}")
	list(LENGTH _entry_parts _entry_parts_count)
	if(_entry_parts_count GREATER 1)
		list(GET _entry_parts 1 _variant)
		set(_variant_args "-BackendProfile=${_variant}")
		set(_entry_tag "${_backend}-${_variant}")
	endif()
	set(_entry_gates ${_expected_gates})
	if(_backend STREQUAL "NullDll")
		set(_entry_gates ${_abi_suite_gates} ${_expected_gates})
	endif()
	foreach(_profile UEParity Normalized)
		set(_dir "${PT_OUT_DIR}/${_entry_tag}_${_profile}")
		# M10: the whole suite writes a conformance stamp; CTest keeps it in its own directory (never Saved/Conformance).
		execute_process(COMMAND "${PT_BENCH_EXE}" -Conformance "-Backend=${_backend}" ${_variant_args} "-Profile=${_profile}" "-Out=${_dir}"
			"-StampDir=${PT_OUT_DIR}/stamps"
			RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
		math(EXPR _runs "${_runs} + 1")
		set(_label "${_entry} ${_profile}")
		if(NOT _rc EQUAL 0)
			list(APPEND _failures "${_label}: exit code ${_rc}\n${_stdout}${_stderr}")
			continue()
		endif()
		if(NOT EXISTS "${_dir}/conformance.json")
			list(APPEND _failures "${_label}: conformance.json missing")
			continue()
		endif()
		# M7: -Conformance leaves exit.json too (exit_code 0 here), the file the M8 runner trusts.
		if(NOT EXISTS "${_dir}/exit.json")
			list(APPEND _failures "${_label}: exit.json missing")
		else()
			file(READ "${_dir}/exit.json" _exit_json)
			string(JSON _exit_code ERROR_VARIABLE _exit_err GET "${_exit_json}" exit_code)
			if(NOT _exit_code EQUAL _rc)
				list(APPEND _failures "${_label}: exit.json exit_code '${_exit_code}' ${_exit_err}")
			endif()
		endif()
		file(READ "${_dir}/conformance.json" _json)
		string(JSON _schema ERROR_VARIABLE _err GET "${_json}" schema)
		string(JSON _result ERROR_VARIABLE _err GET "${_json}" result)
		string(JSON _failed ERROR_VARIABLE _err GET "${_json}" summary failed)
		string(JSON _abi ERROR_VARIABLE _err GET "${_json}" build abi_version)
		string(JSON _tol ERROR_VARIABLE _err GET "${_json}" inputs tolerances_sha256)
		string(JSON _num_gates ERROR_VARIABLE _err LENGTH "${_json}" gates)
		if(NOT _schema STREQUAL "physicstest.conformance/1" OR NOT _result STREQUAL "pass" OR NOT _failed EQUAL 0)
			list(APPEND _failures "${_label}: schema '${_schema}', result '${_result}', failed ${_failed}")
		endif()
		if(NOT _abi STREQUAL "1.1")
			list(APPEND _failures "${_label}: abi_version '${_abi}' (expected 1.1, abi-v1.1)")
		endif()
		string(LENGTH "${_tol}" _tol_length)
		if(NOT _tol_length EQUAL 64)
			list(APPEND _failures "${_label}: tolerances_sha256 '${_tol}'")
		endif()
		set(_ids "")
		math(EXPR _last "${_num_gates} - 1")
		foreach(_index RANGE ${_last})
			string(JSON _id GET "${_json}" gates ${_index} id)
			string(JSON _gate_result GET "${_json}" gates ${_index} result)
			list(APPEND _ids "${_id}")
			if(_gate_result STREQUAL "Fail")
				list(APPEND _failures "${_label}: gate ${_id} failed")
			endif()
		endforeach()
		if(NOT _ids STREQUAL "${_entry_gates}")
			list(APPEND _failures "${_label}: gates '${_ids}', expected '${_entry_gates}'")
		endif()
		# M10 (02 12.4): the whole suite wrote a valid conformance stamp.
		string(JSON _stamp_written ERROR_VARIABLE _stamp_err GET "${_json}" stamp written)
		string(JSON _stamp_valid ERROR_VARIABLE _stamp_err2 GET "${_json}" stamp valid)
		if(_stamp_err OR NOT _stamp_written OR NOT _stamp_valid)
			list(APPEND _failures "${_label}: stamp written '${_stamp_written}', valid '${_stamp_valid}' ${_stamp_err}")
		endif()
		# M6 round 2: the post-run registrations the verdicts used and the count still waiting for the lead's sign-off.
		string(JSON _pending ERROR_VARIABLE _pending_err GET "${_json}" pending_sign_offs)
		string(JSON _num_post ERROR_VARIABLE _post_err LENGTH "${_json}" post_run_registrations)
		if(_pending_err OR _post_err OR NOT _pending MATCHES "^[0-9]+$")
			list(APPEND _failures "${_label}: pending_sign_offs / post_run_registrations missing (${_pending_err} ${_post_err})")
		else()
			set(_count 0)
			set(_post_keys "")
			if(_num_post GREATER 0)
				math(EXPR _last_post "${_num_post} - 1")
				foreach(_post_index RANGE ${_last_post})
					string(JSON _post_key GET "${_json}" post_run_registrations ${_post_index} key)
					string(JSON _sign_off GET "${_json}" post_run_registrations ${_post_index} sign_off)
					list(APPEND _post_keys "${_post_key}")
					if(_sign_off STREQUAL "pending")
						math(EXPR _count "${_count} + 1")
					endif()
				endforeach()
			endif()
			if(NOT _count EQUAL _pending)
				list(APPEND _failures "${_label}: pending_sign_offs ${_pending}, but ${_count} listed registrations are pending")
			endif()
			# M9 commit: the lead signed every post-run registration (2026-10-22); a verdict that rests on an unsigned one fails
			# until the lead signs it (docs/Progress.md M9 리드 결정).
			if(NOT _pending EQUAL 0)
				list(APPEND _failures "${_label}: pending_sign_offs ${_pending} - a verdict rests on a post-run registration the lead has not signed")
			endif()
			# Null's G7 rotation model is a post-run registration (Progress M6 D-6): its verdict rests on it.
			if(_backend MATCHES "^Null" AND NOT "G7.step_angle_model" IN_LIST _post_keys)
				list(APPEND _failures "${_label}: post_run_registrations '${_post_keys}' misses G7.step_angle_model")
			endif()
		endif()
	endforeach()
endforeach()

# ABI gates through the bench (the path a PT_MODULE_NO_REINIT backend takes: one gate per process): A0, A7 and A10 on Null
# (static), A3 on NullDll (the DLL path). The SDK backends run A0-A7 in PhysicsTest.Abi.SdkBackendsA0toA7.
foreach(_abi "Null|A0" "Null|A7" "Null|A10" "NullDll|A3")
	string(REPLACE "|" ";" _abi_parts "${_abi}")
	list(GET _abi_parts 0 _abi_backend)
	list(GET _abi_parts 1 _abi_gate)
	set(_dir "${PT_OUT_DIR}/abi_${_abi_backend}_${_abi_gate}")
	execute_process(COMMAND "${PT_BENCH_EXE}" -Conformance "-Backend=${_abi_backend}" "-Gates=${_abi_gate}" "-Out=${_dir}"
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
	math(EXPR _runs "${_runs} + 1")
	if(NOT _rc EQUAL 0 OR NOT EXISTS "${_dir}/conformance.json")
		list(APPEND _failures "-Conformance -Backend=${_abi_backend} -Gates=${_abi_gate}: exit code ${_rc}\n${_stdout}${_stderr}")
		continue()
	endif()
	file(READ "${_dir}/conformance.json" _json)
	string(JSON _id GET "${_json}" gates 0 id)
	string(JSON _gate_result GET "${_json}" gates 0 result)
	if(NOT _id STREQUAL "${_abi_gate}" OR NOT _gate_result STREQUAL "Pass")
		list(APPEND _failures "-Conformance -Backend=${_abi_backend} -Gates=${_abi_gate}: gate ${_id} ${_gate_result}")
	endif()
endforeach()

# The NO_REINIT test double (M6 round 1): what the Chaos bridge will do, without it. A0 must see the flag set (and the Kit
# refuse the Init after its Term), A10 must pass on its single Init, the physics gates share one Init.
set(ENV{PT_NULL_DLL_NO_REINIT} 1)
foreach(_abi_gate A0 A1 A2 A3 A4 A5 A6 A7 A10 Physics)
	set(_dir "${PT_OUT_DIR}/noreinit_${_abi_gate}")
	set(_gate_args "-Gates=${_abi_gate}")
	if(_abi_gate STREQUAL "Physics")
		set(_gate_args "-Profile=UEParity")
	endif()
	execute_process(COMMAND "${PT_BENCH_EXE}" -Conformance -Backend=NullDll ${_gate_args} "-Out=${_dir}" "-StampDir=${PT_OUT_DIR}/stamps"
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
	math(EXPR _runs "${_runs} + 1")
	set(_label "NO_REINIT double (PT_NULL_DLL_NO_REINIT=1) -Gates=${_abi_gate}")
	if(NOT _rc EQUAL 0 OR NOT EXISTS "${_dir}/conformance.json")
		list(APPEND _failures "${_label}: exit code ${_rc}
${_stdout}${_stderr}")
		continue()
	endif()
	file(READ "${_dir}/conformance.json" _json)
	string(JSON _result GET "${_json}" result)
	string(JSON _display ERROR_VARIABLE _err GET "${_json}" backend display_name)
	if(NOT _result STREQUAL "pass" OR NOT _display MATCHES "NO_REINIT test double")
		list(APPEND _failures "${_label}: result '${_result}', backend '${_display}'")
	endif()
	if(_abi_gate STREQUAL "Physics")
		# the physics gates of the suite (M9 fix round 0: J1 too, a registered Skip on the joint-less double) in one process, and
		# (M10 fix round 0) the ABI gates of the DLL's suite in one fresh process each: every one passes on the NO_REINIT double
		string(JSON _num_gates LENGTH "${_json}" gates)
		list(LENGTH _expected_gates _num_expected)
		list(LENGTH _abi_suite_gates _num_abi)
		math(EXPR _num_expected "${_num_expected} + ${_num_abi}")
		if(NOT _num_gates EQUAL _num_expected)
			list(APPEND _failures "${_label}: ${_num_gates} gates, expected ${_num_expected} (${_abi_suite_gates} ${_expected_gates})")
		endif()
	else()
		string(JSON _id GET "${_json}" gates 0 id)
		string(JSON _gate_result GET "${_json}" gates 0 result)
		if(NOT _id STREQUAL "${_abi_gate}" OR NOT _gate_result STREQUAL "Pass")
			list(APPEND _failures "${_label}: gate ${_id} ${_gate_result}")
		endif()
		if(_abi_gate STREQUAL "A0" OR _abi_gate STREQUAL "A10")
			string(JSON _notes GET "${_json}" gates 0 notes)
			if(NOT _notes MATCHES "PT_MODULE_NO_REINIT set")
				list(APPEND _failures "${_label}: the gate did not see PT_MODULE_NO_REINIT set: ${_notes}")
			endif()
		endif()
	endif()
endforeach()
# A list that would initialise the module twice is refused before any gate runs.
foreach(_bad_list "A0,A1" "A3,G1")
	execute_process(COMMAND "${PT_BENCH_EXE}" -Conformance -Backend=NullDll "-Gates=${_bad_list}" "-Out=${PT_OUT_DIR}/noreinit_refused"
		RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
	math(EXPR _runs "${_runs} + 1")
	if(NOT _rc EQUAL 2 OR NOT "${_stdout}${_stderr}" MATCHES "declares PT_MODULE_NO_REINIT: one -Conformance process runs one ABI gate")
		list(APPEND _failures "NO_REINIT double -Gates=${_bad_list}: expected the refusal (exit 2), got exit code ${_rc}
${_stdout}${_stderr}")
	endif()
endforeach()
unset(ENV{PT_NULL_DLL_NO_REINIT})

# -Describe (Null and every SDK entry) and -List: stdout is pure JSON (every log line on stderr).
set(_json_modes "List" "Describe|Null")
foreach(_entry ${_entries})
	list(APPEND _json_modes "Describe|${_entry}")
endforeach()
foreach(_mode_entry ${_json_modes})
	string(REPLACE "|" ";" _mode_parts "${_mode_entry}")
	list(GET _mode_parts 0 _mode)
	if(_mode STREQUAL "Describe")
		list(GET _mode_parts 1 _describe_entry)
		string(REPLACE "/" ";" _describe_parts "${_describe_entry}")
		list(GET _describe_parts 0 _describe_backend)
		set(_args -Describe "-Backend=${_describe_backend}" -Scenario=S00.FreeFall)
		list(LENGTH _describe_parts _describe_count)
		if(_describe_count GREATER 1)
			list(GET _describe_parts 1 _describe_variant)
			list(APPEND _args "-BackendProfile=${_describe_variant}")
		endif()
		set(_label "-Describe ${_describe_entry}")
	else()
		set(_args -List)
		set(_label "-List")
	endif()
	execute_process(COMMAND "${PT_BENCH_EXE}" ${_args} RESULT_VARIABLE _rc OUTPUT_VARIABLE _stdout ERROR_VARIABLE _stderr)
	math(EXPR _runs "${_runs} + 1")
	string(STRIP "${_stdout}" _stripped)
	string(SUBSTRING "${_stripped}" 0 1 _first)
	string(JSON _probe ERROR_VARIABLE _parse_error TYPE "${_stripped}")
	if(NOT _rc EQUAL 0 OR NOT _first STREQUAL "{" OR _parse_error)
		list(APPEND _failures "${_label}: stdout is not one JSON object (rc ${_rc}, first '${_first}', ${_parse_error})")
	endif()
	if(NOT _stderr MATCHES "PhysicsTestBench [|] preset")
		list(APPEND _failures "${_label}: the log lines did not reach stderr")
	endif()
endforeach()

list(LENGTH _failures _num_failures)
if(_num_failures GREATER 0)
	string(REPLACE ";" "\n" _text "${_failures}")
	message(FATAL_ERROR "FAIL: ${_num_failures} of ${_runs} conformance runs / checks:\n${_text}")
endif()
message(STATUS "PASS: ${_runs} conformance runs / checks: conformance.json with every gate (${_expected_gates}; a DLL backend also ${_abi_suite_gates}, one process each) passing or a registered skip and its post-run registrations counted (pending_sign_offs); the NO_REINIT double runs A0-A7, A10 and the physics gates one process each and refuses mixed lists; -Describe (Null and every SDK entry) / -List stdout is pure JSON")
