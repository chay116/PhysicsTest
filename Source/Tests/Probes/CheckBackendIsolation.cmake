# CheckBackendIsolation.cmake - backends see PT::Abi, PT::BackendCommon and their own SDK only (R4, 02_Architecture 4.5):
# no backend TU has harness Core or PhysicsCore on its include path, and each one defines PT_BACKEND_NS.
#   cmake -DPT_COMPILE_COMMANDS=<compile_commands.json> -DPT_SOURCE_DIR=<repo> -P CheckBackendIsolation.cmake
cmake_minimum_required(VERSION 3.25)
file(READ "${PT_COMPILE_COMMANDS}" _json)
string(JSON _count LENGTH "${_json}")
math(EXPR _last "${_count} - 1")
file(TO_CMAKE_PATH "${PT_SOURCE_DIR}" _src)
string(TOLOWER "${_src}" _src_lower)
set(_checked 0)
set(_violations "")
foreach(_i RANGE 0 ${_last})
	string(JSON _file GET "${_json}" ${_i} file)
	file(TO_CMAKE_PATH "${_file}" _file)
	string(TOLOWER "${_file}" _file_lower)
	string(FIND "${_file_lower}" "${_src_lower}/source/backends/" _pos)
	if(NOT _pos EQUAL 0)
		continue()
	endif()
	string(JSON _cmd GET "${_json}" ${_i} command)
	string(REPLACE "\\" "/" _cmd_n "${_cmd}")
	string(TOLOWER "${_cmd_n}" _cmd_lower)
	math(EXPR _checked "${_checked} + 1")
	foreach(_forbidden "source/runtime/core/" "source/runtime/physicscore/" "source/runtime/physicstestconformance/")
		string(FIND "${_cmd_lower}" "${_forbidden}" _hit)
		if(_hit GREATER -1)
			list(APPEND _violations "${_file}: include path contains ${_forbidden}")
		endif()
	endforeach()
	if(NOT _cmd MATCHES "[-/]DPT_BACKEND_NS=")
		list(APPEND _violations "${_file}: PT_BACKEND_NS is not defined")
	endif()
endforeach()
if(_checked EQUAL 0)
	message(FATAL_ERROR "no backend TU found in ${PT_COMPILE_COMMANDS}")
endif()
if(_violations)
	string(REPLACE ";" "\n  " _text "${_violations}")
	message(FATAL_ERROR "backend isolation violations:\n  ${_text}")
endif()
message(STATUS "PASS: ${_checked} backend TUs see no harness Core / PhysicsCore include path and define PT_BACKEND_NS")
