# CheckKitNamespaces.cmake - 03_WorkPlan M2: with Null and a second static test backend (AbiTwin) linked into one exe,
# the linker map shows the Kit symbols split by backend inline namespace (PhysicsTest::Abi::<PT_BACKEND_NS>), and no Kit
# symbol lives in PhysicsTest::Abi itself (which would let /arch-different backends share a COMDAT, 02_Architecture 7.3).
#   cmake -DPT_MAP=<PhysicsTestAutomation.map> -DPT_ALLOWED=Null;AbiTwin;AutomationTest -DPT_REQUIRED=Null;AbiTwin -P CheckKitNamespaces.cmake
cmake_minimum_required(VERSION 3.25)
if(NOT EXISTS "${PT_MAP}")
	message(FATAL_ERROR "linker map '${PT_MAP}' not found")
endif()
file(STRINGS "${PT_MAP}" _lines REGEX "@Abi@PhysicsTest@@")
set(_counts_text "")
set(_bad "")
foreach(_ns IN LISTS PT_ALLOWED)
	set(_count_${_ns} 0)
endforeach()
set(_total 0)
foreach(_line IN LISTS _lines)
	string(REGEX MATCHALL "[A-Za-z0-9_]+@Abi@PhysicsTest@@" _hits "${_line}")
	foreach(_hit IN LISTS _hits)
		string(REGEX REPLACE "@Abi@PhysicsTest@@$" "" _ns "${_hit}")
		math(EXPR _total "${_total} + 1")
		if(_ns IN_LIST PT_ALLOWED)
			math(EXPR _count_${_ns} "${_count_${_ns}} + 1")
		else()
			list(APPEND _bad "${_ns}")
		endif()
	endforeach()
endforeach()
foreach(_ns IN LISTS PT_ALLOWED)
	string(APPEND _counts_text " ${_ns}=${_count_${_ns}}")
endforeach()
message(STATUS "Kit symbol references by inline namespace:${_counts_text} (total ${_total})")
if(_bad)
	list(REMOVE_DUPLICATES _bad)
	message(FATAL_ERROR "Kit symbols outside a backend inline namespace (PhysicsTest::Abi::<name> with <name> not a backend): ${_bad}")
endif()
foreach(_ns IN LISTS PT_REQUIRED)
	if(_count_${_ns} EQUAL 0)
		message(FATAL_ERROR "no Kit symbol in PhysicsTest::Abi::${_ns} (expected both static backends' copies in the map)")
	endif()
endforeach()
# The same Kit function exists once per backend: FKitServices::SetLastError (variadic, never inlined).
foreach(_ns IN LISTS PT_REQUIRED)
	file(STRINGS "${PT_MAP}" _set_last_error REGEX "\\?SetLastError@FKitServices@${_ns}@Abi@PhysicsTest@@")
	if(NOT _set_last_error)
		message(FATAL_ERROR "FKitServices::SetLastError of backend namespace ${_ns} is not in the map")
	endif()
endforeach()
message(STATUS "PASS: Kit symbols are split by backend inline namespace (${PT_REQUIRED})")
