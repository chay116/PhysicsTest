# CheckKitNeedsBackendNs.cmake - a backend TU that includes PtBackendKit.h without PT_BACKEND_NS must stop with the Kit's
# #error (02_Architecture 4.5, 7.3). The TU (KitWithoutBackendNsProbe.cpp) belongs to an EXCLUDE_FROM_ALL target, so
# compile_commands.json has its exact compiler line; this script runs that line itself, with the object and PDB outputs
# redirected to PT_PROBE_DIR. It never invokes the build system of the tree under test (no reconfigure, no overlap
# with a concurrent build of the same tree). Needs the MSVC environment (Tools\ctest.cmd), as the build does.
#   cmake -DPT_COMPILE_COMMANDS=<compile_commands.json> -DPT_PROBE_DIR=<scratch dir> -P CheckKitNeedsBackendNs.cmake
cmake_minimum_required(VERSION 3.25)
file(READ "${PT_COMPILE_COMMANDS}" _json)
string(JSON _count LENGTH "${_json}")
math(EXPR _last "${_count} - 1")
set(_command "")
foreach(_i RANGE 0 ${_last})
	string(JSON _file GET "${_json}" ${_i} file)
	if(_file MATCHES "[/\\\\]KitWithoutBackendNsProbe\\.cpp$")
		string(JSON _command GET "${_json}" ${_i} command)
		string(JSON _directory GET "${_json}" ${_i} directory)
		break()
	endif()
endforeach()
if(_command STREQUAL "")
	message(FATAL_ERROR "KitWithoutBackendNsProbe.cpp is not in ${PT_COMPILE_COMMANDS}")
endif()
if(_command MATCHES "[-/]DPT_BACKEND_NS")
	message(FATAL_ERROR "the probe TU defines PT_BACKEND_NS; the probe would prove nothing: ${_command}")
endif()

separate_arguments(_args WINDOWS_COMMAND "${_command}")
file(REMOVE_RECURSE "${PT_PROBE_DIR}")
file(MAKE_DIRECTORY "${PT_PROBE_DIR}")
set(_run "")
foreach(_arg IN LISTS _args)
	if(_arg MATCHES "^[-/]Fo")
		list(APPEND _run "/Fo${PT_PROBE_DIR}/KitWithoutBackendNsProbe.obj")
	elseif(_arg MATCHES "^[-/]Fd")
		list(APPEND _run "/Fd${PT_PROBE_DIR}/")
	else()
		list(APPEND _run "${_arg}")
	endif()
endforeach()
execute_process(COMMAND ${_run} WORKING_DIRECTORY "${_directory}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(_rc EQUAL 0)
	message(FATAL_ERROR "KitWithoutBackendNsProbe.cpp compiled without PT_BACKEND_NS; the Kit must stop it with #error")
endif()
if(NOT "${_out}${_err}" MATCHES "PT_BACKEND_NS must be defined per backend target")
	message(FATAL_ERROR "the compile failed (exit ${_rc}) but not with the Kit's #error:\n${_out}${_err}")
endif()
if(EXISTS "${PT_PROBE_DIR}/KitWithoutBackendNsProbe.obj")
	message(FATAL_ERROR "an object file was written despite the #error")
endif()
message(STATUS "PASS: without PT_BACKEND_NS the Kit stops the TU with #error (exit ${_rc}); the build tree was not touched")
