# CheckHarnessSdkIsolation.cmake - harness TUs never see an SDK (03_WorkPlan M3 criterion; 02_Architecture 4.2, 4.5, R4).
# Every TU of this tree under Source/ (and the generated registry) except the SDK side - backend libraries
# (Source/Backends/), SDK smoke tests (Source/Tests/SdkSmoke/) and the Jolt side of the flag-leak probe
# (Source/Tests/Probes/JoltSeam/PtJoltSeam.cpp) - must have:
#   - no SDK include path (jolt-src, bullet3-src, physx-src / physx-build, the PhysX bootstrap tree)
#   - no SDK definition (-DJPH_*, -DBT_*, -DPX_*, DISABLE_CUDA_PHYSX)
#   - with the Shipped flag profile: no /arch option at all (so no __AVX2__)
#   cmake -DPT_COMPILE_COMMANDS=<compile_commands.json> -DPT_SOURCE_DIR=<repo> -DPT_BINARY_DIR=<build>
#         -DPT_FLAG_PROFILE=Shipped -P CheckHarnessSdkIsolation.cmake
cmake_minimum_required(VERSION 3.25)
file(READ "${PT_COMPILE_COMMANDS}" _json)
string(JSON _count LENGTH "${_json}")
math(EXPR _last "${_count} - 1")
file(TO_CMAKE_PATH "${PT_SOURCE_DIR}" _src)
string(TOLOWER "${_src}" _src_lower)
file(TO_CMAKE_PATH "${PT_BINARY_DIR}" _bin)
string(TOLOWER "${_bin}" _bin_lower)
set(_checked 0)
set(_violations "")
foreach(_i RANGE 0 ${_last})
	string(JSON _file GET "${_json}" ${_i} file)
	file(TO_CMAKE_PATH "${_file}" _file)
	string(TOLOWER "${_file}" _file_lower)
	string(FIND "${_file_lower}" "${_src_lower}/source/" _in_source)
	string(FIND "${_file_lower}" "${_bin_lower}/generated/" _in_generated)
	if(NOT _in_source EQUAL 0 AND NOT _in_generated EQUAL 0)
		continue()   # SDK and third-party TUs
	endif()
	set(_sdk_side FALSE)
	foreach(_sdk_dir "${_src_lower}/source/backends/" "${_src_lower}/source/tests/sdksmoke/" "${_src_lower}/source/tests/probes/joltseam/ptjoltseam.cpp")
		string(FIND "${_file_lower}" "${_sdk_dir}" _pos)
		if(_pos EQUAL 0)
			set(_sdk_side TRUE)
		endif()
	endforeach()
	if(_sdk_side)
		continue()
	endif()
	string(JSON _cmd GET "${_json}" ${_i} command)
	string(REPLACE "\\" "/" _cmd_n "${_cmd}")
	string(TOLOWER "${_cmd_n}" _cmd_lower)
	math(EXPR _checked "${_checked} + 1")
	foreach(_forbidden "jolt-src" "bullet3-src" "physx-src" "physx-build" "physxbootstrap")
		string(FIND "${_cmd_lower}" "${_forbidden}" _hit)
		if(_hit GREATER -1)
			list(APPEND _violations "${_file}: an SDK include path (${_forbidden})")
		endif()
	endforeach()
	if(_cmd MATCHES "[-/]D[\"]?(JPH_[A-Za-z0-9_]+|BT_[A-Za-z0-9_]+|PX_[A-Za-z0-9_]+|DISABLE_CUDA_PHYSX)")
		list(APPEND _violations "${_file}: an SDK definition (${CMAKE_MATCH_1})")
	endif()
	if(PT_FLAG_PROFILE STREQUAL "Shipped" AND _cmd_lower MATCHES "[-/]arch:")
		list(APPEND _violations "${_file}: /arch in the Shipped profile (harness TUs never get __AVX2__)")
	endif()
endforeach()
if(_checked EQUAL 0)
	message(FATAL_ERROR "no harness TU found in ${PT_COMPILE_COMMANDS}")
endif()
if(_violations)
	string(REPLACE ";" "\n  " _text "${_violations}")
	message(FATAL_ERROR "harness SDK isolation violations:\n  ${_text}")
endif()
message(STATUS "PASS: ${_checked} harness TUs have no SDK include path, no SDK definition and (${PT_FLAG_PROFILE}) no /arch")
