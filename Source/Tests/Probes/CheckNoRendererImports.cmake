# CheckNoRendererImports.cmake - PhysicsTestBench.exe imports neither d3d11.dll nor dxgi.dll (03_WorkPlan M3 criterion;
# 02_Architecture 4.5, DL33: the bench never creates a D3D device). Reads the import table with dumpbin /dependents.
#   cmake -DPT_EXE=<PhysicsTestBench.exe> -DPT_DUMPBIN=<dumpbin.exe> -P CheckNoRendererImports.cmake
cmake_minimum_required(VERSION 3.25)
execute_process(COMMAND "${PT_DUMPBIN}" /nologo /dependents "${PT_EXE}" OUTPUT_VARIABLE _out ERROR_VARIABLE _err RESULT_VARIABLE _rc)
if(NOT _rc EQUAL 0)
	message(FATAL_ERROR "dumpbin /dependents failed (${_rc}): ${_err}")
endif()
string(TOLOWER "${_out}" _lower)
set(_dlls "")
string(REGEX MATCHALL "[a-z0-9_.-]+\\.dll" _found "${_lower}")
foreach(_dll IN LISTS _found)
	get_filename_component(_name "${_dll}" NAME)
	list(APPEND _dlls "${_name}")
endforeach()
list(REMOVE_DUPLICATES _dlls)
list(REMOVE_ITEM _dlls "physicstestbench.exe")
if(NOT _dlls)
	message(FATAL_ERROR "no imports parsed from dumpbin output:\n${_out}")
endif()
set(_bad "")
foreach(_forbidden d3d11.dll dxgi.dll d3dcompiler_47.dll)
	list(FIND _dlls "${_forbidden}" _index)
	if(_index GREATER -1)
		list(APPEND _bad "${_forbidden}")
	endif()
endforeach()
string(REPLACE ";" ", " _list "${_dlls}")
if(_bad)
	message(FATAL_ERROR "FAIL: ${PT_EXE} imports ${_bad} (imports: ${_list})")
endif()
message(STATUS "PASS: no renderer import; imports: ${_list}")
